node_modules/
.env

# Agent worktrees. `git worktree add .worktrees/<wp>` keeps two agents out of
# one working tree; the checkout inside is a full copy of this repo and must
# never be committed into it.
.worktrees/

# Renders.
#
# A 120s 1080p master is tens of MB, there are eight of them, and git keeps
# every version forever. Masters ship as GitHub Release assets, not as commits.
# Stills are cheap and they are the reviewable record of what a frame looked
# like, so out/stills/ stays.
out/*
!out/stills/
!out/*.srt
!out/*.vtt

# The masters are filed by music version -- out/masters/<version>/ -- because
# the edit is snapped to the take and two takes are two sets of eight. The mp4s
# and the review copies stay out of git; the MANIFEST.json beside them does NOT.
# It is small, it is the record of what was actually produced (sha256, bytes,
# duration, loudness, the commit and the track), and a release asset with no
# record in the repo is a file nobody can later prove anything about.
!out/masters/
out/masters/*/*
!out/masters/*/MANIFEST.json

# An AUDITION renders at full master quality into the quarantine folder, so it
# needs the same treatment: the mp4s stay out, the manifest comes in. Its
# manifest is the more important of the two, because it is the document that
# records `commercialUse: false` -- the reason those files may not ship.
!out/previews/
out/previews/*
!out/previews/AUDITION-not-for-release/
out/previews/AUDITION-not-for-release/*/*
!out/previews/AUDITION-not-for-release/*/MANIFEST.json

# ── What IS tracked, and why it is the opposite of the sibling film ─────────
#
# `../archcanvas-promo-remotion` gitignores `public/` because everything in it
# is copied from elsewhere and re-syncable. THIS repo tracks both `public/` and
# `src/replica/`, and the rule is the same rule reaching the opposite answer:
# a fresh clone must be able to render the film.
#
# There, a clone could re-run `npm run sync:assets` against a sibling repo that
# is public. Here the source is the PRIVATE product repo, and the replica is the
# picture — without it there is no film at all, only a scaffold. So the synced
# bytes are committed, and `src/data/replica-lock.json` is the sha256 ledger
# that says which upstream commit they came from. `npm run verify:replica`
# fails on any drift between the two.
#
# Nothing else about the product is copied here, and this repo must never gain
# an archcanvas git remote.
.worktrees/
